rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Church-scoped testimony media uploads
    match /{churchCollection}/{churchId}/testimonies/{memberId}/{testimonyId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == memberId || request.auth != null);
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
