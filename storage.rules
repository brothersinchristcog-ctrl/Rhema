rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Church-scoped testimony media uploads
    match /{churchCollection}/{churchId}/testimonies/{memberId}/{testimonyId}/{allMedia=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == memberId || request.auth != null);
    }

    // Church-scoped Rhema Chat media (images, videos, voice notes, documents, group avatars)
    match /{churchCollection}/{churchId}/chat/{roomId}/{allPaths=**} {
      allow read: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous' &&
        request.resource != null &&
        request.resource.size < 30 * 1024 * 1024 &&
        (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType.matches('video/.*') ||
          request.resource.contentType.matches('audio/.*') ||
          request.resource.contentType.matches('application/.*') ||
          request.resource.contentType.matches('text/.*')
        );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
