{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": [
    {
      "bucket": "rhema-global-ministries.firebasestorage.app",
      "rules": "storage.rules"
    },
    {
      "bucket": "rhema-global-ministries-matrimony",
      "rules": "storage.matrimony.rules"
    }
  ],
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/invite",
        "function": "guestInviteLanding"
      },
      {
        "source": "/invite/**",
        "function": "guestInviteLanding"
      }
    ]
  }
}
