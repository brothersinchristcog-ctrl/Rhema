rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user logged in?
    function isAuthenticated() {
      return true; // TEMPORARY DEBUG: Bypass Auth check
    }

    // Helper: Is this the user's own document?
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Is this user a platform Super Admin using platform_admins collection & UID
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(path('/databases/' + database + '/documents/platform_admins/' + request.auth.uid)) &&
         (get(path('/databases/' + database + '/documents/platform_admins/' + request.auth.uid)).data.superadmin == true ||
          get(path('/databases/' + database + '/documents/platform_admins/' + request.auth.uid)).data.get('role', '') in ['Super Admin', 'super_admin', 'superadmin', 'SuperAdmin'])) ||
        (exists(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)) &&
         (get(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)).data.get('userType', '') in ['Super Admin', 'super_admin', 'superadmin', 'SuperAdmin'] ||
          get(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)).data.get('role', '') in ['Super Admin', 'super_admin', 'superadmin', 'SuperAdmin'] ||
          get(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)).data.get('isSuperAdmin', false) == true ||
          get(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)).data.get('superadmin', false) == true))
      );
    }

    function isAdminGlobally() {
      return isAuthenticated() && isSuperAdmin();
    }

    // Legacy fallback for top-level collections
    function isAdmin() {
      return isAdminGlobally();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    // Platform Admin root collections
    match /platform_admins/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }


    // Collection Group queries for members, attendance, and bibleQuizzes
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/attendanceRecords/{recordId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/attendees/{attendeeId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/rsvps/{rsvpId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/bibleQuizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }
    match /bibleQuizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/registration_requests/{requestId} {
      allow read, write: if true;
    }

    match /unmappedWhatsappMessages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }



    // 2. Top-level Daily Promises & Videos (legacy, may not be in use)
    match /dailyPromises/{promiseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /daily_verses/{verseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /daily_verses_meta/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /dailyVideos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Top-level Events (legacy, may not be in use)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpStats', 'updatedAt']);

      match /attendees/{attendeeId} {
        allow read, write: if isAuthenticated();
      }
      match /rsvps/{rsvpId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /attendanceRecords/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Prayer Requests
    match /prayerRequests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.type == 'public' || resource.data.isPublic == true || isOwner(resource.data.uid) || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.uid);
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // 5. Announcements
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Giving Transactions (legacy)
    match /givingTransactions/{txId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.uid);
    }

    // 7. Broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Settings
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Public Settings (e.g. Force Update config)
    match /public_settings/{docId} {
      allow read: if true;
      allow write: if isAdminGlobally();
    }

    match /platform_admins/{adminId} {
      allow read: if isAuthenticated();
    }

    // 9. Worship Songs
    match /worshipSongs/{songId} {
      allow read, write: if isAuthenticated();
    }

    // Helper: Is this user a platform super admin?
    function isPlatformAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    // Global Master Songs
    match /masterSongs/{songId} {
      allow read: if isAuthenticated();
      allow write: if isAdminGlobally() || isPlatformAdmin();
    }

    // 10. Subscription Plans
    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Payment Transactions
    match /transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if false; // Only Cloud Functions can update transaction status
    }

    // 12. Unmapped WhatsApp Messages
    match /unmappedWhatsappMessages/{docId} {
      allow read: if isAdminGlobally();
      allow write: if false;
    }

    // 13. Referral Codes
    match /referral_codes/{codeId} {
      allow read, write: if isAuthenticated();
    }

    // 15. Bible Quizzes
    match /bibleQuizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 16. Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read, write: if isAuthenticated();
    }

    // 17. Ledger Donations (Offline / Admin recorded) - Admin writes restricted strictly to Super Admin
    match /ledger_donations/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // 17b. Ledger Expenses - Strictly Super Admin Only
    match /ledger_expenses/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // 18. Church Donations (Online member donations) - Member owns own doc; Super Admin manages all
    match /church_donations/{docId} {
      allow read: if isAuthenticated();
      allow create: if isSuperAdmin() || (
        isAuthenticated() && request.auth != null && (
          request.resource.data.get('userId', '') == request.auth.uid ||
          request.resource.data.get('memberUid', '') == request.auth.uid ||
          request.resource.data.get('memberId', '') == request.auth.uid ||
          request.resource.data.get('uid', '') == request.auth.uid
        )
      );
      allow update, delete: if isSuperAdmin() || (
        isAuthenticated() && request.auth != null && (
          resource.data.get('userId', '') == request.auth.uid ||
          resource.data.get('memberUid', '') == request.auth.uid ||
          resource.data.get('memberId', '') == request.auth.uid ||
          resource.data.get('uid', '') == request.auth.uid
        )
      );
    }

    // --- CHURCH-SCOPED COLLECTIONS (all data lives here) ---
    match /{churchCollection}/{churchId} {
      // Helper: Does a member document carry Church Admin / Pastor / Super Admin flags?
        function hasAdminRoleFlags(mData) {
          return mData.get('isAdmin', false) == true ||
            mData.get('isSuperAdmin', false) == true ||
            mData.get('superadmin', false) == true ||
            mData.get('userType', '') in ['admin', 'super_admin', 'superadmin', 'Admin', 'Super Admin', 'SuperAdmin', 'Pastor', 'pastor', 'Senior Pastor', 'Associate Pastor', 'Youth Pastor', 'Assistant Pastor'] ||
            mData.get('role', '') in ['admin', 'super_admin', 'superadmin', 'Admin', 'Super Admin', 'SuperAdmin', 'Pastor', 'pastor', 'Senior Pastor', 'Associate Pastor', 'Youth Pastor', 'Assistant Pastor'];
        }

        function isSuperAdminMemberDoc(mData) {
          return mData.get('isSuperAdmin', false) == true ||
            mData.get('superadmin', false) == true ||
            mData.get('userType', '') in ['Super Admin', 'super_admin', 'superadmin', 'SuperAdmin'] ||
            mData.get('role', '') in ['Super Admin', 'super_admin', 'superadmin', 'SuperAdmin'];
        }

      // Helper: Is this user an admin for this specific church?
        function isChurchAdminUid(uid) {
          let hasMemberDoc = exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(uid));
          let isMemberAdmin = hasMemberDoc && hasAdminRoleFlags(get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(uid)).data);

          let churchDocPath = /databases/$(database)/documents/$(churchCollection)/$(churchId);
          let churchExists = exists(churchDocPath);
          let parentId = churchExists ? get(churchDocPath).data.get('parentChurchId', null) : null;
          let hasParentMemberDoc = parentId != null && exists(/databases/$(database)/documents/$(churchCollection)/$(parentId)/members/$(uid));
          let isParentAdmin = hasParentMemberDoc && hasAdminRoleFlags(get(/databases/$(database)/documents/$(churchCollection)/$(parentId)/members/$(uid)).data);

          return isMemberAdmin || isParentAdmin || isSuperAdmin();
        }

        function isChurchAdmin() {
          return isAuthenticated() && request.auth != null && isChurchAdminUid(request.auth.uid);
        }

        function isProtectedSuperAdminModule(moduleKey) {
          return moduleKey in ['care_cells', 'expense', 'donations', 'daily_verses', 'app_admin'];
        }

        function hasModulePermission(moduleKey) {
          return request.auth != null && (
            isSuperAdmin() || (
              !isProtectedSuperAdminModule(moduleKey) &&
              isChurchAdmin() && (
                moduleKey == 'dashboard' ||
                (
                  exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/admin_permissions/$(request.auth.uid)) &&
                  get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/admin_permissions/$(request.auth.uid)).data.get('modules', {}).get(moduleKey, false) == true
                ) ||
                (
                  !exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/admin_permissions/$(request.auth.uid)) &&
                  !exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/admin_permission_settings/default_template)
                )
              )
            )
          );
        }

      // Church info is public — allow lookup by code even before login (needed during signup).
      allow read: if true;
      // Any authenticated user can create a new church (they become its admin).
      // The creator can also update the church (e.g. to save logo URL after upload).
      // Only Super Admins can delete a church.
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if hasModulePermission('church_settings') || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      allow delete: if isSuperAdmin();

      // Admin Module Permissions (Written exclusively via Cloud Functions Admin SDK)
      match /admin_permissions/{targetUid} {
        allow read: if isSuperAdmin() || (request.auth != null && request.auth.uid == targetUid);
        allow write: if false;
      }

      match /admin_permission_settings/{settingId} {
        allow read: if request.auth != null && (isSuperAdmin() || isChurchAdmin());
        allow write: if false;
      }

      match /admin_permission_audit_logs/{logId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      // Baptism Requests
      match /baptism_requests/{requestId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if hasModulePermission('baptism') || (
          isAuthenticated() && request.auth != null && (
            resource.data.get('memberId', '') == request.auth.uid ||
            resource.data.get('uid', '') == request.auth.uid
          )
        );
      }

      // Volunteer Applications (General & Event)
      match /volunteer_applications/{applicationId} {
        allow read: if isAuthenticated() && (
          resource.data.memberId == request.auth.uid || 
          hasModulePermission('volunteers')
        );
        allow create: if isAuthenticated() && 
          request.resource.data.memberId == request.auth.uid;
        allow update: if isAuthenticated() && (
          (resource.data.memberId == request.auth.uid && resource.data.status == 'withdrawn') ||
          hasModulePermission('volunteers')
        );
        allow delete: if hasModulePermission('volunteers') || (
          isAuthenticated() &&
          resource.data.memberId == request.auth.uid
        );
      }

      // Promises (Daily Word)
      match /promises/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('promises');
      }

      // Events (Church Schedule)
      match /events/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('events');
        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpStats', 'updatedAt']);

        match /attendees/{attendeeId} {
          allow read, write: if isAuthenticated();
        }
        match /rsvps/{rsvpId} {
          allow read, write: if isAuthenticated();
        }
      }

      // Sermons
      match /sermons/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('sermons');
      }

      // Songs
      match /songs/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('songs');
      }

      // Updates / Announcements
      match /updates/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('notifications');
      }

      // Gallery Albums
      match /gallery_albums/{albumId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('gallery');
        
        match /photos/{photoId} {
          allow read: if isAuthenticated();
          allow write: if hasModulePermission('gallery');
        }
      }

      // About Us content
      match /aboutUs/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('church_settings');
      }

      // Contact Us content
      match /contactUs/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('church_settings');
      }

      // Normalized Phone Index & Guest Invites (per-church anti-duplication & deep-link lookup)
      match /memberPhoneIndex/{phoneKey} {
        allow read, create, update: if isAuthenticated();
        allow delete: if isChurchAdmin() || (
          isAuthenticated() &&
          resource.data.get('memberDocId', '') == request.auth.uid
        );
      }

      match /guestInvites/{inviteId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if isChurchAdmin();
      }

      // Members subcollection
      match /members/{memberId} {
        function leavesAdminPrivilegeIntact() {
          let unchangedRoleKeys = !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userType', 'role', 'isAdmin', 'isSuperAdmin', 'superadmin', 'permissions']);
          let staysRegularMember = !hasAdminRoleFlags(resource.data) && !hasAdminRoleFlags(request.resource.data) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions']);
          return unchangedRoleKeys || staysRegularMember;
        }

        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isSuperAdmin() || !hasAdminRoleFlags(request.resource.data)
        );
        allow update: if isAuthenticated() && (
          isSuperAdmin() || (
            leavesAdminPrivilegeIntact() && (
              isOwner(memberId) ||
              (request.auth != null && request.auth.token.phone_number != null && resource.data.phone == request.auth.token.phone_number) ||
              ((hasModulePermission('members') || hasModulePermission('approvals')) && !isSuperAdminMemberDoc(resource.data))
            )
          )
        );
        allow delete: if isSuperAdmin() || (
          isAuthenticated() && !isSuperAdminMemberDoc(resource.data) && (
            ((hasModulePermission('members') || hasModulePermission('approvals')) && !hasAdminRoleFlags(resource.data)) ||
            isOwner(memberId) ||
            (request.auth != null && request.auth.token.phone_number != null && resource.data.phone == request.auth.token.phone_number)
          )
        );

        // Member Subscriptions
        match /subscriptions/{subId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }

        // Member Notifications (personal volunteer updates, service roster assignments, care cell alerts)
        match /notifications/{notifId} {
          allow read: if isAuthenticated() && (
            request.auth == null ||
            isOwner(memberId) ||
            isChurchAdmin() ||
            (
              exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)) &&
              get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)).data.get('uid', '') == request.auth.uid
            ) ||
            (
              request.auth.token.phone_number != null &&
              exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)) &&
              get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)).data.get('phone', '') == request.auth.token.phone_number
            )
          );
          allow create, update: if isAuthenticated();
          allow delete: if isAuthenticated();
        }

        // Member Bible Reading Progress
        match /bible/{docId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }

        // Member Sermon Subscriptions
        match /sermon_subscriptions/{sermonId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }
      }

      // Prayer Requests (church-scoped)
      match /prayerRequests/{reqId} {
        allow read: if isAuthenticated() && (resource.data.type == 'public' || resource.data.isPublic == true || isOwner(resource.data.uid) || hasModulePermission('prayer_wall'));
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwner(resource.data.uid) || hasModulePermission('prayer_wall');
        
        match /comments/{commentId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
          allow update, delete: if isOwner(resource.data.uid) || hasModulePermission('prayer_wall');
        }
      }

      // Notifications
      match /notifications/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          hasModulePermission('notifications') ||
          hasModulePermission('celebrations') ||
          request.resource.data.type in ['prayer_request_admin', 'baptism_request_admin', 'volunteer_application_admin', 'job_application_admin']
        );
        allow update, delete: if isAuthenticated();
      }

      // Broadcasts (Church scoped updates)
      match /broadcasts/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          hasModulePermission('notifications') ||
          hasModulePermission('celebrations') ||
          request.resource.data.type in ['prayer_request_admin', 'baptism_request_admin']
        );
        allow update, delete: if isAuthenticated();
      }

      // Pastor Events
      match /pastorEvents/{docId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('pastor_events');
      }

      // Secrets subcollection: Only Super Admin or Settings/WhatsApp admins. Cloud Functions use Admin SDK and bypass this.
      match /secrets/{document=**} {
        allow read, write: if isSuperAdmin() || hasModulePermission('church_settings') || hasModulePermission('whatsapp');
      }

      // Integrations subcollection (OAuth tokens): strictly blocked from client access
      match /integrations/{document=**} {
        allow read, write: if false; // Only Cloud Functions can access this
      }

      // Online Meetings
      match /online_meetings/{meetingId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('online_meetings');

        match /attendees/{attendeeId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && request.auth.uid == attendeeId;
        }

        match /rsvps/{rsvpId} {
          allow read, write: if isAuthenticated();
        }
      }

      // Live Celebrations (Chat)
      match /live_celebrations/{dateId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Allow everyone to create the initial document if missing

        match /messages/{msgId} {
          allow read, write: if isAuthenticated();
        }

        match /presence/{docId} {
          allow read, write: if isAuthenticated();
        }

        match /celebrants/{celebId} {
          allow read, write: if isAuthenticated();
        }

        match /e2eeMeta/{docId} {
          allow read, write: if isAuthenticated();
        }

        match /keyEnvelopes/{docId} {
          allow read, write: if isAuthenticated();
        }

        match /keyRequests/{uid} {
          allow read, write: if isAuthenticated();
        }
      }

      // Attendance Requests & Responses
      match /attendanceRequests/{requestId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('attendance');

        match /responses/{responseId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // Attendance Records (Church-wide check-in logs)
      match /attendanceRecords/{recordId} {
        allow read, write: if isAuthenticated();
      }

      // Bible Quizzes
      match /bibleQuizzes/{quizId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('bible_quiz') || (churchId == 'global' && isSuperAdmin());
      }

      // Quiz Attempts (members can create their own attempts, everyone can read leaderboard)
      match /quizAttempts/{attemptId} {
        allow read, write: if isAuthenticated();
      }

      
      // Platform Admin church subcollections
      match /platform_admins/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin();
      }

      // Church Finance - Strictly Super Admin Only
      match /expenses/{expenseId} {
        allow read, write: if isSuperAdmin();
      }

      match /donations/{donationId} {
        allow read: if isAuthenticated();
        allow create: if isSuperAdmin() || (
          isAuthenticated() && request.auth != null && (
            request.resource.data.get('userId', '') == request.auth.uid ||
            request.resource.data.get('memberUid', '') == request.auth.uid ||
            request.resource.data.get('memberId', '') == request.auth.uid ||
            request.resource.data.get('uid', '') == request.auth.uid
          )
        );
        allow update, delete: if isSuperAdmin() || (
          isAuthenticated() && request.auth != null && (
            resource.data.get('userId', '') == request.auth.uid ||
            resource.data.get('memberUid', '') == request.auth.uid ||
            resource.data.get('memberId', '') == request.auth.uid ||
            resource.data.get('uid', '') == request.auth.uid
          )
        );
      }

      match /ledger_donations/{docId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin();
      }

      // Strictly Super Admin Only
      match /ledger_expenses/{docId} {
        allow read, write: if isSuperAdmin();
      }

      match /church_donations/{docId} {
        allow read: if isAuthenticated();
        allow create: if isSuperAdmin() || (
          isAuthenticated() && request.auth != null && (
            request.resource.data.get('userId', '') == request.auth.uid ||
            request.resource.data.get('memberUid', '') == request.auth.uid ||
            request.resource.data.get('memberId', '') == request.auth.uid ||
            request.resource.data.get('uid', '') == request.auth.uid
          )
        );
        allow update, delete: if isSuperAdmin() || (
          isAuthenticated() && request.auth != null && (
            resource.data.get('userId', '') == request.auth.uid ||
            resource.data.get('memberUid', '') == request.auth.uid ||
            resource.data.get('memberId', '') == request.auth.uid ||
            resource.data.get('uid', '') == request.auth.uid
          )
        );
      }

      // Member Pledges (Non-donation commitments; server verifies payment fulfillment)
      match /pledges/{pledgeId} {
        allow read: if isAuthenticated() && (
          resource.data.memberUid == request.auth.uid || isSuperAdmin()
        );
        allow create: if isAuthenticated() &&
          request.resource.data.memberUid == request.auth.uid &&
          request.resource.data.receivedAmount == 0 &&
          request.resource.data.consentConfirmed == true;
        allow update: if isSuperAdmin() || (
          isAuthenticated() &&
          resource.data.memberUid == request.auth.uid &&
          request.resource.data.receivedAmount == resource.data.receivedAmount &&
          request.resource.data.pledgeAmount == resource.data.pledgeAmount
        );
        allow delete: if isSuperAdmin() || (
          isAuthenticated() &&
          resource.data.memberUid == request.auth.uid &&
          resource.data.receivedAmount == 0
        );
      }

      // Razorpay Recurring Subscription Mandates (Written only by Cloud Functions)
      match /recurring_mandates/{subscriptionId} {
        allow read: if isAuthenticated() && (
          resource.data.memberUid == request.auth.uid || isSuperAdmin()
        );
        allow write: if false;
      }

      // Razorpay cached plans
      match /razorpay_plans/{planKey} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }

      // Care Cells Management Module
      match /careCells/{cellId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          (resource.data.assignedAdminIds != null && request.auth.uid in resource.data.assignedAdminIds) ||
          resource.data.leaderId == request.auth.uid ||
          resource.data.assistantLeaderId == request.auth.uid ||
          resource.data.status == 'Active'
        );
        allow create: if isSuperAdmin();
        allow update: if isSuperAdmin() || (
          isAuthenticated() && (
            (resource.data.assignedAdminIds != null && request.auth.uid in resource.data.assignedAdminIds) ||
            resource.data.leaderId == request.auth.uid ||
            resource.data.assistantLeaderId == request.auth.uid
          )
        );
        allow delete: if isSuperAdmin();
      }

      match /careCellMemberships/{membershipId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellMeetings/{meetingId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellAttendance/{attendanceId} {
        allow read, write: if isAuthenticated();
      }

      match /careCellPrayerRequests/{requestId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isChurchAdmin() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      }

      match /careCellFollowups/{followupId} {
        allow read, write: if isAuthenticated();
      }

      match /careCellAnnouncements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellMeetingReports/{reportId} {
        allow read, write: if isAuthenticated();
      }

      // Service Roster & Worship Operations Management Module
      match /servicePlans/{planId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('service_roster');

        match /assignmentQueues/{queueId} {
          allow read: if isAuthenticated();
          allow create, delete: if hasModulePermission('service_roster');
          allow update: if isAuthenticated();
        }

        match /rehearsals/{rehearsalId} {
          allow read: if isAuthenticated();
          allow write: if hasModulePermission('service_roster');
        }

        match /attendance/{attendanceId} {
          allow read: if isAuthenticated();
          allow write: if hasModulePermission('service_roster');
        }
      }

      match /serviceTemplates/{templateId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('service_roster');
      }

      match /ministryTeams/{teamId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('service_roster') || hasModulePermission('job_circle');
      }

      match /memberSkills/{skillId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
        allow update, delete: if hasModulePermission('service_roster');
      }

      match /memberAvailability/{availabilityId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.resource.data.memberId == request.auth.uid || hasModulePermission('service_roster'));
      }

      match /registration_requests/{requestId} {
        allow read, write: if true;
      }

      // Testimonies Management Module (Public feeds, Private pastoral care, and Admin review)
      match /testimonies/{testimonyId} {
        // Read: Admins, submitting member, or anyone when Public & Published
        allow read: if isAuthenticated() && (
          hasModulePermission('testimonies') ||
          (resource.data.memberId != null && resource.data.memberId == request.auth.uid) ||
          (resource.data.privacy == 'Public' && resource.data.status == 'Published')
        );

        // Create: Member submitting their own testimony (or admin)
        allow create: if isAuthenticated() && (
          hasModulePermission('testimonies') || (
            request.resource.data.memberId == request.auth.uid && (
              (request.resource.data.privacy == 'Private' && request.resource.data.status == 'Private') ||
              (request.resource.data.privacy == 'Public' && request.resource.data.status == 'Pending Review')
            )
          )
        );

        // Update:
        // - Admin: can approve/publish/reject, but cannot publish a Private testimony
        // - Member: can edit their own testimony, but cannot set status to 'Approved' or 'Published'
        allow update: if isAuthenticated() && (
          (hasModulePermission('testimonies') && !(resource.data.privacy == 'Private' && request.resource.data.status == 'Published')) ||
          (
            resource.data.memberId == request.auth.uid &&
            request.resource.data.memberId == request.auth.uid &&
            !(request.resource.data.status in ['Approved', 'Published'])
          )
        );

        // Delete: Admins or the submitting Member
        allow delete: if isAuthenticated() && (
          hasModulePermission('testimonies') || resource.data.memberId == request.auth.uid
        );
      }

      // Job Circle & Ministry Recruitment Module
      match /job_circle_categories/{catId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('job_circle');
      }

      match /job_circle_settings/{settingId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('job_circle');
      }

      match /job_circle_opportunities/{opportunityId} {
        allow read: if isAuthenticated();
        allow create, delete: if hasModulePermission('job_circle');
        allow update: if hasModulePermission('job_circle') || (
          isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationsCount'])
        );
      }

      match /job_circle_applications/{applicationId} {
        allow read: if isAuthenticated() && (
          hasModulePermission('job_circle') ||
          request.auth == null ||
          resource.data.memberId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          hasModulePermission('job_circle') ||
          request.auth == null ||
          request.resource.data.memberId == request.auth.uid
        );
        allow update: if hasModulePermission('job_circle') || (
          isAuthenticated() &&
          (request.auth == null || resource.data.memberId == request.auth.uid) &&
          request.resource.data.status == 'withdrawn'
        );
        allow delete: if hasModulePermission('job_circle');
      }

      // --- KIDS MINISTRY & SUNDAY SCHOOL MANAGEMENT SYSTEM ---
      // Children Profile & Safeguarding
      match /kids_children/{childId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if hasModulePermission('kids_ministry');
      }

      // Sunday School Classrooms & Capacities
      match /kids_classes/{classId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('kids_ministry');
      }

      // Check-In Sessions & Custody Passes
      match /kids_sessions/{sessionId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if hasModulePermission('kids_ministry') || (
          request.auth != null && (
            resource.data.get('parentMemberId', '') == request.auth.uid ||
            resource.data.get('familyId', '') == request.auth.uid ||
            (request.auth.token.phone_number != null && resource.data.get('parentPhone', '') == request.auth.token.phone_number)
          )
        );
      }

      // Program-Based Kids Ministry Sessions (Sunday School, VBS, Special Meetings, etc.)
      match /kids_program_sessions/{programSessionId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if hasModulePermission('kids_ministry');
      }

      // Program-Wise Kids Attendance Records (Present & Finalized Absent)
      match /kids_attendance/{attendanceId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if hasModulePermission('kids_ministry') || (
          request.auth != null && (
            resource.data.get('parentMemberId', '') == request.auth.uid ||
            resource.data.get('familyId', '') == request.auth.uid ||
            (request.auth.token.phone_number != null && resource.data.get('parentPhone', '') == request.auth.token.phone_number)
          )
        );
      }

      // Teachers & Volunteers Faculty
      match /kids_teachers/{teacherId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('kids_ministry');
      }

      // Teacher Face/PIN Clock-in Attendance
      match /kids_teacher_attendance/{attendanceId} {
        allow read, write: if isAuthenticated();
      }

      // Bible Learning Center: Stories, Quizzes, Songs
      match /kids_stories/{storyId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
      }
      match /kids_quizzes/{quizId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
      }
      match /kids_songs/{songId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
      }
      match /kids_verses/{verseId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
      }

      // 52-Week Curriculum Syllabus
      match /kids_curriculum/{weekId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
      }

      // Kids Events & Vacation Bible School (VBS)
      match /kids_events/{eventId} {
        allow read: if true;
        allow write: if hasModulePermission('kids_ministry');
        allow update: if isAuthenticated();
      }

      // Safeguarding Audit Trail
      match /kids_audit_logs/{logId} {
        allow read, write: if isAuthenticated();
      }

      // --- RHEMA CHURCH CHAT & GROUP MESSAGING (Strict auth: no debug bypass) ---
      function isRealChurchMember() {
        return request.auth != null &&
          request.auth.token.firebase.sign_in_provider != 'anonymous' &&
          exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(request.auth.uid));
      }

      function isRhemaChatAdmin() {
        return isChurchAdmin() || (
          isRealChurchMember() &&
          get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(request.auth.uid)).data.get('userType', '') in ['Pastor', 'pastor', 'Admin', 'admin', 'Super Admin', 'super_admin', 'superadmin']
        );
      }

      match /chat_groups/{groupId} {
        allow read: if isRealChurchMember() && (
          isRhemaChatAdmin() ||
          request.auth.uid in resource.data.get('participantIds', [])
        );
        allow create: if isRhemaChatAdmin() &&
          request.resource.data.createdBy == request.auth.uid;
        allow update: if isRealChurchMember() && (
          isRhemaChatAdmin() ||
          request.auth.uid in resource.data.get('adminIds', []) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantIds', 'adminIds', 'updatedAt']) &&
            request.auth.uid in resource.data.get('participantIds', []) &&
            !(request.auth.uid in request.resource.data.get('participantIds', []))
          )
        );
        allow delete: if isRhemaChatAdmin();
      }

      match /chat_blocks/{blockerUid}/blocked/{targetUid} {
        allow read, write: if isRealChurchMember() && request.auth.uid == blockerUid;
      }

      match /chat_reports/{reportId} {
        allow create: if isRealChurchMember() &&
          request.resource.data.reporterUid == request.auth.uid;
        allow read, update, delete: if isRhemaChatAdmin();
      }

      match /branches/{branchId} {
        allow read: if isAuthenticated();
        allow write: if hasModulePermission('church_settings');
      }

      match /support_tickets/{ticketId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if hasModulePermission('support_team') || (
          isAuthenticated() && request.auth != null && (
            resource.data.get('memberId', '') == request.auth.uid ||
            resource.data.get('uid', '') == request.auth.uid
          )
        );
      }

      // Any other church subcollection: authenticated members can read, admins can write
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }
    }

    // =========================================================================
    // RHEMA MATRIMONY MODULE (Strict auth: never uses temporary debug bypass)
    // =========================================================================
    function matrimonySignedIn() {
      return request.auth != null;
    }

    function isMatrimonyOwner(uid) {
      return matrimonySignedIn() && request.auth.uid == uid;
    }

    match /matrimony_profiles/{uid} {
      allow read: if matrimonySignedIn() && (
        isMatrimonyOwner(uid) ||
        (resource.data.profileStatus == 'approved' && resource.data.visibility == 'discoverable')
      );
      allow write: if false;

      match /private/{docId} {
        allow read, write: if false;
      }

      match /preferences/{docId} {
        allow read, write: if false;
      }

      match /verification/{docId} {
        allow read, write: if false;
      }

      match /shortlists/{docId} {
        allow read, write: if false;
      }

      match /blocks/{docId} {
        allow read: if isMatrimonyOwner(uid);
        allow write: if false;
      }
    }

    match /matrimony_bans/{uid} {
      allow read, write: if false;
    }

    match /matrimony_private/{uid} {
      allow read, write: if false;
    }

    match /matrimony_preferences/{uid} {
      allow read, write: if false;
    }

    match /matrimony_verifications/{uid} {
      allow read, write: if false;
    }

    match /matrimony_interests/{id} {
      allow read: if matrimonySignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.receiverUid == request.auth.uid
      );
      allow write: if false;
    }

    match /matrimony_matches/{id} {
      allow read: if matrimonySignedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    match /matrimony_recommendations/{uid}/items/{candidateUid} {
      allow read: if isMatrimonyOwner(uid);
      allow write: if false;
    }

    match /matrimony_chats/{chatId} {
      allow read: if matrimonySignedIn() &&
        request.auth.uid in resource.data.participantIds;
      allow write: if false;

      match /messages/{messageId} {
        allow read: if matrimonySignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/matrimony_chats/$(chatId)).data.participantIds;
        allow write: if false;
      }
    }

    match /matrimony_shortlists/{uid}/saved/{targetUid} {
      allow read, write: if false;
    }

    match /matrimony_guardians/{uid}/authorized/{guardianUid} {
      allow read, write: if false;
    }

    match /matrimony_blocks/{uid}/blocked/{targetUid} {
      allow read, write: if false;
    }

    match /matrimony_reports/{id} {
      allow read, write: if false;
    }

    match /matrimony_notifications/{id} {
      allow read: if matrimonySignedIn() &&
        resource.data.recipientUid == request.auth.uid;
      allow write: if false;
    }

    match /matrimony_settings/{id} {
      allow read: if matrimonySignedIn();
      allow write: if false;
    }

    match /matrimony_audit_logs/{id} {
      allow read, write: if false;
    }

    match /matrimony_admin_profiles/{uid} {
      allow read, write: if false;
    }

    match /matrimony_plans/{planId} {
      allow read: if matrimonySignedIn();
      allow write: if false;
    }

    match /matrimony_subscriptions/{uid} {
      allow read: if isMatrimonyOwner(uid);
      allow write: if false;
    }

    match /matrimony_entitlements/{uid} {
      allow read: if isMatrimonyOwner(uid);
      allow write: if false;
    }

    match /matrimony_usage/{uid} {
      allow read: if isMatrimonyOwner(uid);
      allow write: if false;
    }

    match /matrimony_payment_history/{paymentId} {
      allow read: if matrimonySignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // End-to-End Encryption Identity Public Keys & Encrypted Private Key Backups
    match /user_e2ee_keys/{uid} {
      allow read: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if request.auth != null && request.auth.uid == uid;

      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
