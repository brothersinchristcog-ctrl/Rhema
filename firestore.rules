rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user logged in?
    function isAuthenticated() {
      return true; // TEMPORARY DEBUG: Bypass Auth check
    }

    // Helper: Is this the user's own document?
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper: Is this user a platform Super Admin using platform_admins collection & UID
    function isSuperAdmin() {
      return request.auth != null && (
        (exists(path('/databases/' + database + '/documents/platform_admins/' + request.auth.uid)) &&
         get(path('/databases/' + database + '/documents/platform_admins/' + request.auth.uid)).data.superadmin == true) ||
        (exists(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)) &&
         get(path('/databases/' + database + '/documents/Rhema Church/rhema/members/' + request.auth.uid)).data.get('userType', '') in ['Super Admin', 'super_admin', 'superadmin'])
      );
    }

    function isAdminGlobally() {
      return isAuthenticated() && isSuperAdmin();
    }

    // Legacy fallback for top-level collections
    function isAdmin() {
      return isAdminGlobally();
    }

    // --- TOP-LEVEL COLLECTIONS ---

    // Platform Admin root collections
    match /platform_admins/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }


    // Collection Group queries for members, attendance, and bibleQuizzes
    match /{path=**}/members/{memberId} {
      allow read: if isAuthenticated();
    }
    match /{path=**}/attendanceRecords/{recordId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/attendees/{attendeeId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/rsvps/{rsvpId} {
      allow read, write: if isAuthenticated();
    }
    match /{path=**}/bibleQuizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }
    match /bibleQuizzes/{quizId} {
      allow read, write: if isAuthenticated();
    }

    match /{path=**}/registration_requests/{requestId} {
      allow read, write: if true;
    }

    match /unmappedWhatsappMessages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }



    // 2. Top-level Daily Promises & Videos (legacy, may not be in use)
    match /dailyPromises/{promiseId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /daily_verses/{verseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /daily_verses_meta/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /dailyVideos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 3. Top-level Events (legacy, may not be in use)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpStats', 'updatedAt']);

      match /attendees/{attendeeId} {
        allow read, write: if isAuthenticated();
      }
      match /rsvps/{rsvpId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /attendanceRecords/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Prayer Requests
    match /prayerRequests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.type == 'public' || isOwner(resource.data.uid));
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwner(resource.data.uid);
      
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isOwner(resource.data.uid);
      }
    }

    // 5. Announcements
    match /announcements/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 6. Giving Transactions (legacy)
    match /givingTransactions/{txId} {
      allow read, write: if isAuthenticated() && isOwner(resource.data.uid);
    }

    // 7. Broadcasts
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 8. Settings
    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    // Public Settings (e.g. Force Update config)
    match /public_settings/{docId} {
      allow read: if true;
      allow write: if isAdminGlobally();
    }

    match /platform_admins/{adminId} {
      allow read: if isAuthenticated();
    }

    // 9. Worship Songs
    match /worshipSongs/{songId} {
      allow read, write: if isAuthenticated();
    }

    // Helper: Is this user a platform super admin?
    function isPlatformAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    // Global Master Songs
    match /masterSongs/{songId} {
      allow read: if isAuthenticated();
      allow write: if isAdminGlobally() || isPlatformAdmin();
    }

    // 10. Subscription Plans
    match /subscription_plans/{planId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 11. Payment Transactions
    match /transactions/{txId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if false; // Only Cloud Functions can update transaction status
    }

    // 12. Unmapped WhatsApp Messages
    match /unmappedWhatsappMessages/{docId} {
      allow read: if isAdminGlobally();
      allow write: if false;
    }

    // 13. Referral Codes
    match /referral_codes/{codeId} {
      allow read, write: if isAuthenticated();
    }

    // 14. Vouchers
    match /vouchers/{voucherCode} {
      allow read, write: if isAuthenticated();
    }

    // 15. Bible Quizzes
    match /bibleQuizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
      match /{allChildren=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 16. Quiz Attempts
    match /quizAttempts/{attemptId} {
      allow read, write: if isAuthenticated();
    }

    // 17. Ledger Donations (Offline / Admin recorded)
    match /ledger_donations/{docId} {
      allow read, write: if isAuthenticated();
    }

    // 17b. Ledger Expenses
    match /ledger_expenses/{docId} {
      allow read, write: if isAuthenticated();
    }

    // 18. Church Donations (Online member donations)
    match /church_donations/{docId} {
      allow read, write: if isAuthenticated();
    }

    // --- CHURCH-SCOPED COLLECTIONS (all data lives here) ---
    match /{churchCollection}/{churchId} {
      // Helper: Is this user an admin for this specific church?
        function isChurchAdminUid(uid) {
          let hasMemberDoc = exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(uid));
          let isMemberAdmin = hasMemberDoc && get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(uid)).data.get('userType', '') in ['admin', 'super_admin', 'Admin', 'Super Admin'];

          let churchDocPath = /databases/$(database)/documents/$(churchCollection)/$(churchId);
          let churchExists = exists(churchDocPath);
          let parentId = churchExists ? get(churchDocPath).data.get('parentChurchId', null) : null;
          let hasParentMemberDoc = parentId != null && exists(/databases/$(database)/documents/$(churchCollection)/$(parentId)/members/$(uid));
          let isParentAdmin = hasParentMemberDoc && get(/databases/$(database)/documents/$(churchCollection)/$(parentId)/members/$(uid)).data.get('userType', '') in ['admin', 'super_admin', 'Admin', 'Super Admin'];

          return isMemberAdmin || isParentAdmin || isSuperAdmin();
        }

        function isChurchAdmin() {
          return isAuthenticated() && request.auth != null && isChurchAdminUid(request.auth.uid);
        }

      // Church info is public — allow lookup by code even before login (needed during signup).
      allow read: if true;
      // Any authenticated user can create a new church (they become its admin).
      // The creator can also update the church (e.g. to save logo URL after upload).
      // Only existing admins can delete a church.
      allow create: if isAuthenticated() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isChurchAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
      allow delete: if isChurchAdmin();

      // Baptism Requests
      match /baptism_requests/{requestId} {
        allow read, write: if isAuthenticated();
      }

      // Volunteer Applications (General & Event)
      match /volunteer_applications/{applicationId} {
        allow read: if isAuthenticated() && (
          resource.data.memberId == request.auth.uid || 
          isChurchAdmin()
        );
        allow create: if isAuthenticated() && 
          request.resource.data.memberId == request.auth.uid;
        allow update: if isAuthenticated() && (
          (resource.data.memberId == request.auth.uid && request.resource.data.status == 'withdrawn') ||
          isChurchAdmin()
        );
        allow delete: if isChurchAdmin() || (
          isAuthenticated() &&
          resource.data.memberId == request.auth.uid
        );
      }

      // Promises (Daily Word)
      match /promises/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Events (Church Schedule)
      match /events/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
        allow update: if isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvpStats', 'updatedAt']);

        match /attendees/{attendeeId} {
          allow read, write: if isAuthenticated();
        }
        match /rsvps/{rsvpId} {
          allow read, write: if isAuthenticated();
        }
      }

      // Sermons
      match /sermons/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Songs
      match /songs/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Updates / Announcements
      match /updates/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Gallery Albums
      match /gallery_albums/{albumId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
        
        match /photos/{photoId} {
          allow read: if isAuthenticated();
          allow write: if isChurchAdmin();
        }
      }

      // About Us content
      match /aboutUs/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Contact Us content
      match /contactUs/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Normalized Phone Index & Guest Invites (per-church anti-duplication & deep-link lookup)
      match /memberPhoneIndex/{phoneKey} {
        allow read, create, update: if isAuthenticated();
        allow delete: if isChurchAdmin() || (
          isAuthenticated() &&
          resource.data.get('memberDocId', '') == request.auth.uid
        );
      }

      match /guestInvites/{inviteId} {
        allow read, create, update: if isAuthenticated();
        allow delete: if isChurchAdmin();
      }

      // Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated(); // Allow new member creation during signup
        allow update: if isAuthenticated() && (isOwner(memberId) || (request.auth != null && isChurchAdmin()) || (request.auth != null && request.auth.token.phone_number != null && resource.data.phone == request.auth.token.phone_number));
        allow delete: if (request.auth != null && isChurchAdmin()) || (isAuthenticated() && (isOwner(memberId) || (request.auth != null && request.auth.token.phone_number != null && resource.data.phone == request.auth.token.phone_number)));

        // Member Subscriptions
        match /subscriptions/{subId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }

        // Member Notifications (personal volunteer updates, service roster assignments, care cell alerts)
        match /notifications/{notifId} {
          allow read: if isAuthenticated() && (
            request.auth == null ||
            isOwner(memberId) ||
            isChurchAdmin() ||
            (
              exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)) &&
              get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)).data.get('uid', '') == request.auth.uid
            ) ||
            (
              request.auth.token.phone_number != null &&
              exists(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)) &&
              get(/databases/$(database)/documents/$(churchCollection)/$(churchId)/members/$(memberId)).data.get('phone', '') == request.auth.token.phone_number
            )
          );
          allow create, update: if isAuthenticated();
          allow delete: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }

        // Member Bible Reading Progress
        match /bible/{docId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }

        // Member Sermon Subscriptions
        match /sermon_subscriptions/{sermonId} {
          allow read, write: if isAuthenticated() && (request.auth == null || isOwner(memberId) || isChurchAdmin());
        }
      }

      // Prayer Requests (church-scoped)
      match /prayerRequests/{reqId} {
        allow read: if isAuthenticated() && (resource.data.type == 'public' || isOwner(resource.data.uid));
        allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwner(resource.data.uid) || isChurchAdmin();
        
        match /comments/{commentId} {
          allow read: if isAuthenticated();
          allow create: if isAuthenticated();
          allow update, delete: if isOwner(resource.data.uid) || isChurchAdmin();
        }
      }

      // Notifications
      match /notifications/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isChurchAdmin() || 
          request.resource.data.type in ['prayer_request_admin', 'baptism_request_admin', 'volunteer_application_admin']
        );
        allow update, delete: if isChurchAdmin();
      }

      // Broadcasts (Church scoped updates)
      match /broadcasts/{docId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && (
          isChurchAdmin() || 
          request.resource.data.type in ['prayer_request_admin', 'baptism_request_admin']
        );
        allow update, delete: if isChurchAdmin();
      }

      // Pastor Events
      match /pastorEvents/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      // Secrets subcollection: Only admins. Cloud Functions use Admin SDK and bypass this.
      match /secrets/{document=**} {
        allow read, write: if isChurchAdmin();
      }

      // Integrations subcollection (OAuth tokens): strictly blocked from client access
      match /integrations/{document=**} {
        allow read, write: if false; // Only Cloud Functions can access this
      }

      // Online Meetings
      match /online_meetings/{meetingId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();

        match /attendees/{attendeeId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated() && request.auth.uid == attendeeId;
        }

        match /rsvps/{rsvpId} {
          allow read, write: if isAuthenticated();
        }
      }

      // Live Celebrations (Chat)
      match /live_celebrations/{dateId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated(); // Allow everyone to create the initial document if missing

        match /messages/{msgId} {
          allow read, write: if isAuthenticated();
        }

        match /presence/{docId} {
          allow read, write: if isAuthenticated();
        }

        match /celebrants/{celebId} {
          allow read, write: if isAuthenticated();
        }
      }

      // Attendance Requests & Responses
      match /attendanceRequests/{requestId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();

        match /responses/{responseId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
        }
      }

      // Attendance Records (Church-wide check-in logs)
      match /attendanceRecords/{recordId} {
        allow read, write: if isAuthenticated();
      }

      // Bible Quizzes
      match /bibleQuizzes/{quizId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin() || churchId == 'global' || isAuthenticated();
      }

      // Quiz Attempts (members can create their own attempts, everyone can read leaderboard)
      match /quizAttempts/{attemptId} {
        allow read, write: if isAuthenticated();
      }

      
      // Platform Admin church subcollections
      match /platform_admins/{document=**} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin();
      }

      // Church Finance - Strictly Super Admin Only
      match /expenses/{expenseId} {
        allow read, write: if isSuperAdmin();
      }

      match /donations/{donationId} {
        allow read, write: if isAuthenticated();
      }

      match /ledger_donations/{docId} {
        allow read, write: if isAuthenticated();
      }

      match /ledger_expenses/{docId} {
        allow read, write: if isAuthenticated();
      }

      match /church_donations/{docId} {
        allow read, write: if isAuthenticated();
      }

      // Care Cells Management Module
      match /careCells/{cellId} {
        allow read: if isAuthenticated() && (
          isSuperAdmin() ||
          (resource.data.assignedAdminIds != null && request.auth.uid in resource.data.assignedAdminIds) ||
          resource.data.leaderId == request.auth.uid ||
          resource.data.assistantLeaderId == request.auth.uid ||
          resource.data.status == 'Active'
        );
        allow create: if isSuperAdmin();
        allow update: if isSuperAdmin() || (
          isAuthenticated() && (
            (resource.data.assignedAdminIds != null && request.auth.uid in resource.data.assignedAdminIds) ||
            resource.data.leaderId == request.auth.uid ||
            resource.data.assistantLeaderId == request.auth.uid
          )
        );
        allow delete: if isSuperAdmin();
      }

      match /careCellMemberships/{membershipId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellMeetings/{meetingId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellAttendance/{attendanceId} {
        allow read, write: if isAuthenticated();
      }

      match /careCellPrayerRequests/{requestId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isChurchAdmin() || (isAuthenticated() && resource.data.memberId == request.auth.uid);
      }

      match /careCellFollowups/{followupId} {
        allow read, write: if isAuthenticated();
      }

      match /careCellAnnouncements/{announcementId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /careCellMeetingReports/{reportId} {
        allow read, write: if isAuthenticated();
      }

      // Service Roster & Worship Operations Management Module
      match /servicePlans/{planId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();

        match /assignmentQueues/{queueId} {
          allow read: if isAuthenticated();
          allow create, delete: if isChurchAdmin();
          allow update: if isAuthenticated();
        }

        match /rehearsals/{rehearsalId} {
          allow read: if isAuthenticated();
          allow write: if isChurchAdmin();
        }

        match /attendance/{attendanceId} {
          allow read: if isAuthenticated();
          allow write: if isChurchAdmin();
        }
      }

      match /serviceTemplates/{templateId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /ministryTeams/{teamId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }

      match /memberSkills/{skillId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.memberId == request.auth.uid;
        allow update, delete: if isChurchAdmin();
      }

      match /memberAvailability/{availabilityId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && (request.resource.data.memberId == request.auth.uid || isChurchAdmin());
      }

      match /registration_requests/{requestId} {
        allow read, write: if true;
      }

      // Testimonies Management Module (Public feeds, Private pastoral care, and Admin review)
      match /testimonies/{testimonyId} {
        // Read: Admins, submitting member, or anyone when Public & Published
        allow read: if isAuthenticated() && (
          isChurchAdmin() ||
          (resource.data.memberId != null && resource.data.memberId == request.auth.uid) ||
          (resource.data.privacy == 'Public' && resource.data.status == 'Published')
        );

        // Create: Member submitting their own testimony (or admin)
        allow create: if isAuthenticated() && (
          isChurchAdmin() || (
            request.resource.data.memberId == request.auth.uid && (
              (request.resource.data.privacy == 'Private' && request.resource.data.status == 'Private') ||
              (request.resource.data.privacy == 'Public' && request.resource.data.status == 'Pending Review')
            )
          )
        );

        // Update:
        // - Admin: can approve/publish/reject, but cannot publish a Private testimony
        // - Member: can edit their own testimony, but cannot set status to 'Approved' or 'Published'
        allow update: if isAuthenticated() && (
          (isChurchAdmin() && !(resource.data.privacy == 'Private' && request.resource.data.status == 'Published')) ||
          (
            resource.data.memberId == request.auth.uid &&
            request.resource.data.memberId == request.auth.uid &&
            !(request.resource.data.status in ['Approved', 'Published'])
          )
        );

        // Delete: Admins or the submitting Member
        allow delete: if isAuthenticated() && (
          isChurchAdmin() || resource.data.memberId == request.auth.uid
        );
      }
      }

      // Any other church subcollection: authenticated members can read, admins can write
      match /{subcollection}/{docId} {
        allow read: if isAuthenticated();
        allow write: if isChurchAdmin();
      }
    }
  }
}
