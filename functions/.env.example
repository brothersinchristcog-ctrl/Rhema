# Copy to functions/.env and populate real credentials locally / in Cloud Shell.
# NEVER commit functions/.env with real keys or secrets.

# ── Razorpay Credentials for Member Donations (Give tab) ──
# Set Covenant Synergy Private Limited keys here first for testing.
# Later, swap these two values to Rhema Global Ministries keys and redeploy
# functions — zero application code changes required.
RAZORPAY_GIVING_KEY_ID=
RAZORPAY_GIVING_KEY_SECRET=
RAZORPAY_GIVING_WEBHOOK_SECRET=

# ── Default / Platform / Matrimony Razorpay Credentials ──
# Also acts as fallback if RAZORPAY_GIVING_* values are unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
